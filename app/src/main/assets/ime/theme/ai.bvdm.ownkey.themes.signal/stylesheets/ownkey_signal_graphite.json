{
  "$schema": "https://schemas.florisboard.org/snygg/v2/stylesheet",
  "@defines": {
    "--primary": "#DE5F14",
    "--primary-variant": "#C35412",
    "--on-primary": "#FFFFFF",
    "--secondary": "#DE5F14",
    "--secondary-variant": "#DE5F14",
    "--glide-trail": "#DE5F14B3",
    "--caps-lock": "#DE5F14",
    "--background": "#1C1C1E",
    "--surface": "#3A3A3C",
    "--surface-fn": "#2C2C2E",
    "--surface-variant": "#545456",
    "--popup-surface": "#545456",
    "--popup-shadow": "0dp",
    "--focused-popup-surface": "#FFFFFF",
    "--on-focused-popup": "#1C1C1E",
    "--enter": "#545456",
    "--on-enter": "#FFFFFF",
    "--enter-pressed": "#636366",
    "--on-background": "#FFFFFF",
    "--on-background-disabled": "#FFFFFF61",
    "--on-surface": "#FFFFFF",
    "--on-surface-variant": "#AEAEB2",
    "--on-hint": "#AEAEB2",
    "--toolbar-icon": "#AEAEB2",
    "--toolbar-icon-disabled": "#AEAEB261",
    "--candidate": "#D1D1D6",
    "--pill": "#FFFFFF",
    "--on-pill": "#000000",
    "--incognito": "#FFFFFF11",
    "--shape": "rounded-corner(8dp, 8dp, 8dp, 8dp)",
    "--shape-variant": "rounded-corner(16dp, 16dp, 16dp, 16dp)",
    "--shape-chip": "rounded-corner(50%, 50%, 50%, 50%)"
  },
  "window": {
    "background": "var(--background)",
    "foreground": "var(--on-background)"
  },
  "window[windowmode=`floating`]": {
    "shadow-elevation": "8dp",
    "shape": "rounded-corner(5%, 5%, 5%, 5%)"
  },
  "window-move-handle[windowmode=`fixed`]": {
    "background": "var(--surface)",
    "foreground": "var(--on-surface)",
    "font-size": "24sp",
    "margin": "16dp 0dp",
    "padding": "8dp",
    "shape": "circle()"
  },
  "window-resize-handle": {
    "background": "var(--on-surface-variant)"
  },
  "window-resize-action[windowmode=`fixed`]": {
    "background": "var(--pill)",
    "foreground": "var(--on-pill)",
    "font-size": "24sp",
    "padding": "8dp",
    "shape": "circle()"
  },
  "window-resize-action[windowmode=`floating`]": {
    "background": "var(--surface)",
    "foreground": "var(--on-surface)",
    "shape": "circle()"
  },
  "floating-dock-to-fixed-indicator": {
    "background": "var(--on-surface-variant)"
  },
  "key": {
    "background": "var(--surface)",
    "foreground": "var(--on-surface)",
    "font-size": "21sp",
    "font-weight": "normal",
    "shape": "var(--shape)",
    "text-max-lines": "1",
    "shadow-elevation": "0dp"
  },
  "key:pressed": {
    "background": "var(--surface-variant)",
    "foreground": "var(--on-surface)"
  },
  "key[code=-13..-1,-28..-21,-207..-201,-213..-212,-228..-221,-233,9]": {
    "background": "var(--surface-fn)"
  },
  "key[code=10]": {
    "background": "var(--enter)",
    "foreground": "var(--on-enter)"
  },
  "key[code=10]:pressed": {
    "background": "var(--enter-pressed)",
    "foreground": "var(--on-enter)"
  },
  "key[code=32]": {
    "foreground": "var(--on-surface-variant)",
    "font-size": "13sp",
    "text-overflow": "ellipsis"
  },
  "key[code=-203..-201]": {
    "font-size": "16sp"
  },
  "key[code=-205..-204]": {
    "font-size": "12sp"
  },
  "key[code=-205]": {
    "text-max-lines": "2"
  },
  "key[code=-11][shiftstate=`caps_lock`]": {
    "foreground": "var(--caps-lock)"
  },
  "key-hint": {
    "background": "transparent",
    "foreground": "var(--on-hint)",
    "font-size": "9sp",
    "padding": "0dp 5dp 6dp 0dp",
    "text-max-lines": "1"
  },
  "key-popup-box": {
    "background": "var(--popup-surface)",
    "foreground": "var(--on-surface)",
    "font-size": "21sp",
    "shape": "var(--shape)",
    "shadow-elevation": "var(--popup-shadow)"
  },
  "key-popup-element:focus": {
    "background": "var(--focused-popup-surface)",
    "foreground": "var(--on-focused-popup)",
    "shape": "var(--shape)"
  },
  "key-popup-element[code=-255]": {
    "font-size": "18sp",
    "text-max-lines": "1"
  },
  "key-popup-extended-indicator": {
    "font-size": "16sp"
  },
  "smartbar": {
    "background": "var(--background)",
    "foreground": "var(--on-surface)",
    "font-size": "18sp"
  },
  "smartbar-shared-actions-toggle": {
    "background": "transparent",
    "foreground": "var(--toolbar-icon)",
    "margin": "0dp",
    "shape": "circle()",
    "shadow-elevation": "0dp"
  },
  "smartbar-shared-actions-toggle:pressed": {
    "background": "var(--popup-surface)"
  },
  "smartbar-extended-actions-row": {
    "background": "transparent",
    "foreground": "var(--toolbar-icon)",
    "margin": "3dp 10dp",
    "padding": "0dp 16dp",
    "shape": "var(--shape-chip)",
    "shadow-elevation": "0dp"
  },
  "smartbar-extended-actions-toggle": {
    "background": "transparent",
    "foreground": "var(--toolbar-icon)",
    "margin": "0dp",
    "shape": "circle()",
    "shadow-elevation": "0dp"
  },
  "smartbar-extended-actions-toggle:pressed": {
    "background": "var(--popup-surface)"
  },
  "smartbar-action-key": {
    "background": "transparent",
    "foreground": "var(--toolbar-icon)",
    "font-size": "22sp",
    "margin": "0dp",
    "shape": "circle()",
    "shadow-elevation": "0dp"
  },
  "smartbar-action-key:pressed": {
    "background": "var(--popup-surface)",
    "foreground": "var(--toolbar-icon)"
  },
  "smartbar-action-key:disabled": {
    "foreground": "var(--toolbar-icon-disabled)"
  },
  "smartbar-actions-overflow": {
    "margin": "0dp"
  },
  "smartbar-actions-overflow-customize-button": {
    "background": "var(--popup-surface)",
    "foreground": "var(--on-surface)",
    "font-size": "14sp",
    "margin": "0dp 8dp 0dp 0dp",
    "shape": "var(--shape-chip)"
  },
  "smartbar-action-tile": {
    "background": "var(--surface)",
    "foreground": "var(--on-surface)",
    "font-size": "13sp",
    "margin": "4dp",
    "padding": "4dp",
    "shape": "var(--shape-variant)",
    "text-align": "center",
    "text-max-lines": "2",
    "text-overflow": "ellipsis"
  },
  "smartbar-action-tile:pressed": {
    "background": "var(--surface-variant)"
  },
  "smartbar-action-tile:disabled": {
    "foreground": "var(--on-background-disabled)"
  },
  "smartbar-action-tile-icon": {
    "foreground": "var(--on-surface)",
    "font-size": "24sp",
    "margin": "0dp 0dp 0dp 8dp"
  },
  "smartbar-actions-editor": {
    "background": "var(--background)",
    "foreground": "var(--on-background)",
    "shape": "rounded-corner(20dp, 20dp, 0dp, 0dp)"
  },
  "smartbar-actions-editor-header": {
    "background": "var(--background)",
    "foreground": "var(--on-background)",
    "font-size": "16sp",
    "text-max-lines": "1",
    "text-overflow": "ellipsis"
  },
  "smartbar-actions-editor-header-button": {
    "margin": "4dp",
    "shape": "circle()"
  },
  "smartbar-actions-editor-subheader": {
    "foreground": "var(--on-surface)",
    "font-size": "13sp",
    "font-weight": "medium",
    "padding": "12dp 16dp 12dp 8dp",
    "text-max-lines": "1",
    "text-overflow": "ellipsis"
  },
  "smartbar-actions-editor-tile-grid": {
    "margin": "4dp 0dp"
  },
  "smartbar-actions-editor-tile": {
    "background": "var(--surface)",
    "foreground": "var(--on-surface)",
    "margin": "4dp",
    "padding": "8dp",
    "shape": "var(--shape-variant)",
    "text-align": "center",
    "text-max-lines": "2",
    "text-overflow": "ellipsis"
  },
  "smartbar-actions-editor-tile[code=-999]": {
    "foreground": "var(--on-background-disabled)"
  },
  "smartbar-actions-editor-tile[code=-991]": {
    "foreground": "var(--on-surface-variant)"
  },
  "smartbar-candidate-word": {
    "background": "transparent",
    "foreground": "var(--candidate)",
    "font-size": "16sp",
    "margin": "4dp",
    "padding": "8dp 0dp",
    "shape": "var(--shape)",
    "text-max-lines": "1",
    "text-overflow": "ellipsis"
  },
  "smartbar-candidate-word[auto-commit=1]": {
    "foreground": "var(--on-surface)",
    "font-weight": "medium"
  },
  "smartbar-candidate-word:pressed": {
    "background": "var(--surface)",
    "foreground": "var(--on-surface)"
  },
  "smartbar-candidate-word-secondary-text": {
    "font-size": "9sp",
    "margin": "0dp 2dp 0dp 0dp"
  },
  "smartbar-candidate-clip": {
    "background": "transparent",
    "foreground": "var(--candidate)",
    "font-size": "14sp",
    "margin": "4dp",
    "padding": "8dp 0dp",
    "shape": "var(--shape)",
    "text-max-lines": "1",
    "text-overflow": "ellipsis"
  },
  "smartbar-candidate-clip:pressed": {
    "background": "var(--surface)",
    "foreground": "var(--on-surface)"
  },
  "smartbar-candidate-clip-icon": {
    "margin": "0dp 0dp 4dp 0dp"
  },
  "smartbar-candidate-spacer": {
    "foreground": "transparent"
  },
  "clipboard-header": {
    "foreground": "var(--on-background)",
    "font-size": "16sp"
  },
  "clipboard-header-button": {
    "margin": "4dp",
    "shape": "circle()"
  },
  "clipboard-header-button:disabled": {
    "foreground": "var(--on-background-disabled)"
  },
  "clipboard-header-text": {
    "text-max-lines": "1",
    "text-overflow": "ellipsis"
  },
  "clipboard-subheader": {
    "foreground": "var(--on-surface-variant)",
    "font-size": "13sp",
    "font-weight": "medium",
    "margin": "6dp 10dp 6dp 6dp"
  },
  "clipboard-content": {
    "padding": "10dp 0dp"
  },
  "clipboard-filter-row": {
    "background": "transparent",
    "foreground": "var(--on-background)",
    "padding": "0dp 0dp 4dp 0dp"
  },
  "clipboard-filter-chip": {
    "background": "var(--surface)",
    "foreground": "var(--on-surface)",
    "margin": "4dp 4dp 0dp 4dp",
    "padding": "8dp 4dp",
    "shape": "var(--shape-chip)"
  },
  "clipboard-filter-chip[state=`active`]": {
    "background": "var(--pill)",
    "foreground": "var(--on-pill)"
  },
  "clipboard-filter-chip-text": {
    "margin": "4dp 0dp 0dp 0dp"
  },
  "clipboard-grid": {
    "shape": "var(--shape-variant)"
  },
  "clipboard-item": {
    "background": "var(--popup-surface)",
    "foreground": "var(--on-surface)",
    "font-size": "14sp",
    "margin": "4dp",
    "shape": "var(--shape-variant)",
    "shadow-elevation": "0dp",
    "text-max-lines": "10",
    "text-overflow": "ellipsis"
  },
  "clipboard-item[type=`text`]": {
    "padding": "12dp 10dp"
  },
  "clipboard-item-description": {
    "foreground": "var(--on-surface-variant)",
    "font-size": "12sp"
  },
  "clipboard-item-popup": {
    "background": "var(--popup-surface)",
    "foreground": "var(--on-surface)",
    "font-size": "14sp",
    "margin": "4dp",
    "shape": "var(--shape-variant)",
    "shadow-elevation": "var(--popup-shadow)"
  },
  "clipboard-item-popup[type=`text`]": {
    "padding": "12dp 10dp"
  },
  "clipboard-item-timestamp": {
    "foreground": "var(--on-surface-variant)",
    "font-size": "11sp",
    "padding": "16dp 8dp"
  },
  "clipboard-item-actions": {
    "background": "var(--popup-surface)",
    "foreground": "var(--on-surface)",
    "margin": "4dp",
    "shape": "var(--shape-variant)",
    "shadow-elevation": "var(--popup-shadow)"
  },
  "clipboard-item-action": {
    "font-size": "16sp",
    "padding": "12dp"
  },
  "clipboard-item-action-text": {
    "margin": "4dp 0dp 0dp 0dp"
  },
  "clipboard-clear-all-dialog": {
    "background": "var(--popup-surface)",
    "foreground": "var(--on-surface)",
    "shape": "var(--shape-variant)",
    "shadow-elevation": "var(--popup-shadow)"
  },
  "clipboard-clear-all-dialog-message": {
    "padding": "16dp"
  },
  "clipboard-clear-all-dialog-buttons": {
    "padding": "4dp"
  },
  "clipboard-clear-all-dialog-button": {
    "background": "transparent",
    "foreground": "var(--on-surface)",
    "shape": "var(--shape-chip)"
  },
  "clipboard-history-disabled-title": {
    "font-weight": "medium"
  },
  "clipboard-history-disabled-message": {
    "foreground": "var(--on-surface-variant)",
    "padding": "0dp 4dp 0dp 8dp"
  },
  "clipboard-history-disabled-button": {
    "background": "var(--pill)",
    "foreground": "var(--on-pill)",
    "shape": "var(--shape-chip)"
  },
  "clipboard-history-locked-title": {
    "font-weight": "medium",
    "text-align": "center"
  },
  "clipboard-history-locked-message": {
    "foreground": "var(--on-surface-variant)",
    "padding": "0dp 4dp 0dp 0dp",
    "text-align": "center"
  },
  "extracted-landscape-input-layout": {
    "background": "var(--background)"
  },
  "extracted-landscape-input-field": {
    "background": "var(--popup-surface)",
    "foreground": "var(--on-surface)",
    "font-size": "16sp",
    "shape": "var(--shape-chip)",
    "border-width": "0dp"
  },
  "extracted-landscape-input-action": {
    "background": "var(--pill)",
    "foreground": "var(--on-pill)",
    "shape": "var(--shape-chip)"
  },
  "glide-trail": {
    "foreground": "var(--glide-trail)"
  },
  "incognito-mode-indicator": {
    "foreground": "var(--incognito)"
  },
  "inline-autofill-chip": {
    "background": "var(--popup-surface)",
    "foreground": "var(--on-surface)"
  },
  "media-emoji-subheader": {
    "foreground": "var(--on-surface-variant)",
    "font-size": "13sp",
    "font-weight": "medium",
    "margin": "4dp"
  },
  "media-emoji-key": {
    "background": "transparent",
    "foreground": "var(--on-background)",
    "font-size": "22sp",
    "shape": "var(--shape)"
  },
  "media-emoji-key:pressed": {
    "background": "var(--surface)",
    "foreground": "var(--on-surface)"
  },
  "media-emoji-key-popup-box": {
    "background": "var(--popup-surface)",
    "foreground": "var(--on-surface)",
    "font-size": "22sp",
    "shape": "var(--shape)",
    "shadow-elevation": "var(--popup-shadow)"
  },
  "media-emoji-key-popup-element:focus": {
    "background": "var(--focused-popup-surface)",
    "shape": "var(--shape)"
  },
  "media-emoji-key-popup-extended-indicator": {
    "foreground": "inherit"
  },
  "media-emoji-tab": {
    "foreground": "var(--on-surface-variant)"
  },
  "media-emoji-tab:focus": {
    "foreground": "var(--on-surface)"
  },
  "media-bottom-row-button": {
    "padding": "16dp 0dp",
    "shape": "var(--shape)"
  },
  "one-handed-panel": {
    "background": "var(--background)",
    "foreground": "var(--on-surface)"
  },
  "one-handed-panel-button": {
    "background": "var(--surface)",
    "foreground": "var(--on-surface)",
    "font-size": "24sp",
    "padding": "8dp",
    "shape": "circle()"
  },
  "subtype-panel": {
    "background": "var(--background)",
    "foreground": "var(--on-background)",
    "shape": "rounded-corner(20dp, 20dp, 0dp, 0dp)"
  },
  "subtype-panel-header": {
    "background": "var(--background)",
    "foreground": "var(--on-surface)",
    "font-size": "18sp",
    "padding": "12dp",
    "text-align": "center",
    "text-max-lines": "1",
    "text-overflow": "ellipsis"
  },
  "subtype-panel-list-item": {
    "font-size": "16sp",
    "padding": "16dp"
  },
  "subtype-panel-list-item-icon-leading": {
    "font-size": "24sp",
    "padding": "0dp 0dp 16dp 0dp"
  },
  "subtype-panel-list-item-text": {
    "text-max-lines": "1",
    "text-overflow": "ellipsis"
  }
}
